# ==============================================================================
# Government College Connect (GASC Connect) — Backend Production Configuration
# Copy this file to .env and provide your actual production credentials.
# NEVER commit the active .env file or real secrets to source control.
# ==============================================================================

# Network & Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
API_PREFIX=/api/v1
# In production, restrict CORS to your official college domains / app origins (comma-separated):
CORS_ORIGIN=https://connect.gasckuthalam.edu.in,https://admin.gasckuthalam.edu.in

# MongoDB Production Connection (Replica Set / Atlas URI recommended)
# Format: mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/gasc_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gasc_portal

# JWT Token Security (Mandatory: generate cryptographically strong 64+ char random strings)
# Example generation command: openssl rand -base64 48
JWT_ACCESS_SECRET=your_production_secure_access_secret_at_least_64_chars_long
JWT_REFRESH_SECRET=your_production_secure_refresh_secret_at_least_64_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Initial Primary Administrator Bootstrap (Used only on clean instance initialization)
INITIAL_ADMIN_IDENTIFIER=ADMIN001
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin@2026!

# Institution Identification
COLLEGE_NAME="Government Arts and Science College, Kuthalam"
COLLEGE_AFFILIATION="Affiliated with Annamalai University, Mayiladuthurai District, Tamil Nadu"
COLLEGE_CODE="GASC-KUTHALAM"
COLLEGE_ADDRESS="Kuthalam, Mayiladuthurai District, Tamil Nadu - 609801"

# Payment Gateway Configuration (Optional - Razorpay / Sandbox / Production)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Generative AI Study & Assistant Integration (Optional - Google Gemini)
# If blank, the assistant runs on the built-in verified institutional knowledge engine
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Firebase Cloud Messaging (Optional for background push alerts)
FCM_SERVER_KEY=

