# ==============================================================================
# Government College Connect — Mobile & Frontend Production Configuration
# Copy this file to .env in the mobile directory for environment overrides.
# ==============================================================================

# Backend REST API Base URL
# Local Android Emulator: http://10.0.2.2:5000/api/v1
# Local iOS Simulator / Web: http://localhost:5000/api/v1
# Physical Device on Wi-Fi: http://<LAN_IP>:5000/api/v1
# Production Deployed URL:
EXPO_PUBLIC_API_URL=https://api.gasckuthalam.edu.in/api/v1

# Real-Time WebSocket Gateway URL (Optional, defaults to origin of EXPO_PUBLIC_API_URL)
# Production Deployed Socket Gateway:
EXPO_PUBLIC_SOCKET_URL=https://api.gasckuthalam.edu.in

